     <!doctype html>
<html>
<head>
  <meta charset="utf-8"/>
  <title>Home - Blood Requests</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="header">
    <h2>لوحة الطلبات</h2>
    <div>
      <a class="btn" href="register.html">Register</a>
      <a class="btn" href="login.html">Login</a>
      <a class="btn" href="create-request.html">Create Request</a>
      <a class="btn" href="requests.html">View Requests</a>
      <a class="btn" href="admin.html">Admin</a>
    </div>
  </div>

  <div id="content"></div>

  <script>
    const API_BASE = "http://localhost:5000/api";
    async function loadLatest(){
      const res = await fetch(`${API_BASE}/request/all?page=1&limit=5`);
      const json = await res.json();
      const content = document.getElementById("content");
      content.innerHTML = "";
      if(json.data && json.data.length){
        json.data.forEach(r => {
          const div = document.createElement("div");
          div.className = "card";
          div.innerHTML = `<strong>${r.type} — ${r.name}</strong><p class="small">${r.city} · ${r.blood} · ${new Date(r.createdAt).toLocaleString()}</p>
          <p>${r.description || ""}</p>`;
          content.appendChild(div);
        });
      } else {
        content.innerHTML = `<p class="small">لا توجد طلبات حالياً.</p>`;
      }
    }
    loadLatest();
  </script>
</body>
</html>

     ├── requests.html
     <!doctype html>
<html>
<head><meta charset="utf-8"/><title>Requests</title><link rel="stylesheet" href="style.css"></head>
<body>
  <div class="header"><h2>All Requests</h2><div><a class="btn" href="create-request.html">Create</a></div></div>
  <div id="list"></div>
  <script>
    const API_BASE = "http://localhost:5000/api";
    async function load(page=1){
      const res = await fetch(`${API_BASE}/request/all?page=${page}&limit=20`);
      const j = await res.json();
      const list = document.getElementById("list");
      list.innerHTML = "";
      if(j.data && j.data.length){
        j.data.forEach(r=>{
          const d = document.createElement("div");
          d.className = "card";
          d.innerHTML = `<div class="flex"><strong>${r.type} — ${r.name}</strong><span class="right small">${new Date(r.createdAt).toLocaleString()}</span></div>
            <p class="small">${r.city} · ${r.blood} · ${r.phone}</p>
            <p>${r.description||""}</p>`;
          list.appendChild(d);
        });
      } else list.innerHTML = "<p class='small'>No requests</p>";
    }
    load();
  </script>
</body>
</html>

     ├── create-request.html
     <!doctype html>
<html>
<head><meta charset="utf-8"/><title>Create Request</title><link rel="stylesheet" href="style.css"></head>
<body>
  <div class="header"><h2>Create Request</h2><div><a class="btn" href="requests.html">All Requests</a></div></div>
  <div class="card">
    <div class="form-group"><label>Type</label><input id="type" placeholder="مثال: طلب تبرع"></div>
    <div class="form-group"><label>Name</label><input id="name"></div>
    <div class="form-group"><label>City</label><input id="city"></div>
    <div class="form-group"><label>Phone</label><input id="phone"></div>
    <div class="form-group"><label>Blood Type</label><input id="blood"></div>
    <div class="form-group"><label>Description</label><textarea id="description"></textarea></div>
    <div class="form-group"><label>GPS (optional)</label><input id="gps"></div>
    <button id="submit" class="btn">Create</button>
    <p id="msg" class="small"></p>
  </div>

  <script>
    const API_BASE = "http://localhost:5000/api";
    document.getElementById("submit").onclick = async () => {
      const token = localStorage.getItem("token");
      const body = {
        type: document.getElementById("type").value,
        name: document.getElementById("name").value,
        city: document.getElementById("city").value,
        phone: document.getElementById("phone").value,
        blood: document.getElementById("blood").value,
        description: document.getElementById("description").value,
        gps: document.getElementById("gps").value
      };
      const msg = document.getElementById("msg");
      if(!token){ msg.textContent = "Please login first"; return; }
      const res = await fetch(`${API_BASE}/request/create`, {
        method:"POST",
        headers: {"Content-Type":"application/json", "Authorization": "Bearer "+token},
        body: JSON.stringify(body)
      });
      const j = await res.json();
      msg.textContent = j.msg || JSON.stringify(j);
      if(res.status === 201) setTimeout(()=> location.href="requests.html",700);
    };
  </script>
</body>
</html>

     ├── login.html
     <!doctype html>
<html>
<head><meta charset="utf-8"/><title>Login</title><link rel="stylesheet" href="style.css"></head>
<body>
  <div class="header"><h2>Login</h2><div><a class="btn" href="register.html">Register</a></div></div>
  <div class="card">
    <div class="form-group"><label>Email</label><input id="email" type="email"></div>
    <div class="form-group"><label>Password</label><input id="password" type="password"></div>
    <button id="submit" class="btn">Login</button>
    <p id="msg" class="small"></p>
  </div>

  <script>
    const API_BASE = "http://localhost:5000/api";
    document.getElementById("submit").onclick = async () => {
      const email = document.getElementById("email").value.trim();
      const password = document.getElementById("password").value;
      const msg = document.getElementById("msg");
      const res = await fetch(`${API_BASE}/auth/login`, {
        method:"POST",
        headers: {"Content-Type":"application/json"},
        body: JSON.stringify({email,password})
      });
      const j = await res.json();
      if(res.ok){
        localStorage.setItem("token", j.token);
        localStorage.setItem("user", JSON.stringify(j.user));
        msg.textContent = "تم تسجيل الدخول";
        setTimeout(()=> location.href="index.html",600);
      } else {
        msg.textContent = j.msg || JSON.stringify(j);
      }
    };
  </script>
</body>
</html>

